## @file
#  Exynos 9820 UFS driver taken unchanged from the owner's working beyond2ltePkg
#  firmware (BOOT dump of 2026-11-20; built from Mu-Silicium SamsungPkg UfsDxe with a
#  9820 PlatformUfsLib, "UFS: Board init (Exynos 9820 / beyond2lte)"). Upstream
#  Mu-Silicium has only PlatformUfsLibNull for the 9820, so its UfsDxe cannot start.
#  Depends on gEfiPcdProtocolGuid; uses the ChipInfo protocol and the "UFS UniPro",
#  "UFS HCI" and "UFS IO Coherency" memory map entries.
#  SHA-256 of UfsDxe.efi: 673e2feb3ef39b403c5c1e7272a256b9f4a35d6f07c2b42a407ae23d8eadac1b
##
[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = B2LUfsDxe
  FILE_GUID      = 6E2A7B54-1C3D-4F1E-9B8A-2D4C5E6F7A81
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0

[Binaries.AARCH64]
  PE32|UfsDxe.efi|*
  DXE_DEPEX|UfsDxe.depex|*
